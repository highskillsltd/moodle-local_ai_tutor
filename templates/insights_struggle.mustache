{{!
    @template local_ai_tutor/insights_struggle

    Context variables required for this template:
    * hasrows - bool.
    * rows - array of {title, url, studentcount, students}.
}}
<div class="local-ai-tutor-insights-section">
    <h3>{{#str}}strugglepatterns, local_ai_tutor{{/str}}</h3>
    {{#hasrows}}
    <table class="generaltable">
        <thead>
            <tr>
                <th>{{#str}}col_topic, local_ai_tutor{{/str}}</th>
                <th>{{#str}}col_studentcount, local_ai_tutor{{/str}}</th>
                <th>{{#str}}col_students, local_ai_tutor{{/str}}</th>
            </tr>
        </thead>
        <tbody>
            {{#rows}}
            <tr>
                <td>{{#url}}<a href="{{url}}" target="_blank" rel="noopener">{{title}}</a>{{/url}}{{^url}}{{title}}{{/url}}</td>
                <td>{{studentcount}}</td>
                <td>{{students}}</td>
            </tr>
            {{/rows}}
        </tbody>
    </table>
    {{/hasrows}}
    {{^hasrows}}
    <p>{{#str}}nostrugglesyet, local_ai_tutor{{/str}}</p>
    {{/hasrows}}
</div>
