{{!
    @template local_ai_tutor/citation

    One citation chip rendered under an answer.

    Context variables required for this template:
    * id - string, e.g. "C1".
    * title - string, source title.
    * url - string, link back to the source in Moodle.
    * confidencehigh - bool, true when confidence is "high".
    * confidencelabel - string, human-readable confidence label.

    Example context (json):
    {
        "id": "C1",
        "title": "Introduction to Photosynthesis",
        "url": "https://moodle.example.com/mod/page/view.php?id=42",
        "confidencehigh": true,
        "confidencelabel": "high"
    }
}}
<a href="{{url}}" class="local-ai-tutor-citation {{#confidencehigh}}confidence-high{{/confidencehigh}}{{^confidencehigh}}confidence-medium{{/confidencehigh}}" target="_blank" rel="noopener">
    <span class="citation-id">{{id}}</span>
    <span class="citation-title">{{title}}</span>
    <span class="citation-confidence">{{confidencelabel}}</span>
</a>
