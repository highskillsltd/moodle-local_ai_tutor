{{!
    @template local_ai_tutor/connects_to

    The "connects the dots" related-content list rendered under an answer.

    Context variables required for this template:
    * label - string, section heading (already localized).
    * items - array of {title, url}.
}}
<div class="local-ai-tutor-connects">
    <div class="local-ai-tutor-connects-label">{{label}}</div>
    {{#items}}
    <a href="{{url}}" target="_blank" rel="noopener" class="local-ai-tutor-connects-item">{{title}}</a>
    {{/items}}
</div>
