{{!
    @template local_ai_tutor/chat_panel

    Floating chat widget shell. amd/src/chatbox.js drives all interaction
    inside this markup — the template only provides the static structure.

    Context variables required for this template:
    * title - string, the widget header label.
    * posclass - string, one of local-ai-tutor-pos-{topright,topleft,bottomright,bottomleft}.
    * greeting - string, the personalized opening message shown as the first bubble.
    * closelabel - string, aria-label for the close button.

    Styling lives in styles.css (plugin root), auto-loaded by Moodle's theme
    CSS pipeline — not inlined here.

    Example context (json):
    {
        "title": "AI Tutor",
        "posclass": "local-ai-tutor-pos-bottomright",
        "greeting": "Hi Sam, ask me about anything in this course.",
        "closelabel": "Close"
    }
}}
<div id="local-ai-tutor-widget" class="local-ai-tutor-widget {{posclass}}">
    <button type="button" id="local-ai-tutor-toggle" class="local-ai-tutor-toggle">
        {{title}}
    </button>
    <div id="local-ai-tutor-panel" class="local-ai-tutor-panel">
        <div class="local-ai-tutor-header">
            <span>{{title}}</span>
            <button type="button" id="local-ai-tutor-close" aria-label="{{closelabel}}">&times;</button>
        </div>
        <div id="local-ai-tutor-messages" class="local-ai-tutor-messages">
            <div class="local-ai-tutor-bubble local-ai-tutor-bubble-tutor">{{greeting}}</div>
        </div>
        <div id="local-ai-tutor-status" class="local-ai-tutor-status"></div>
        <form id="local-ai-tutor-form" class="local-ai-tutor-form">
            <input type="text" id="local-ai-tutor-input" autocomplete="off">
            <button type="submit" id="local-ai-tutor-send"></button>
        </form>
    </div>
</div>
