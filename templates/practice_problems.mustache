{{!
    @template local_ai_tutor/practice_problems

    Stuck-student practice problems rendered under an answer.

    Context variables required for this template:
    * label - string, section heading (already localized).
    * items - array of {text}.

    Example context (json):
    {
        "label": "Practice problems",
        "items": [
            {"text": "Balance the chemical equation for photosynthesis."}
        ]
    }
}}
<div class="local-ai-tutor-practice">
    <div class="local-ai-tutor-practice-label">{{label}}</div>
    <ol>
        {{#items}}
        <li>{{text}}</li>
        {{/items}}
    </ol>
</div>
